# Todas as variáveis abaixo são opcionais - o MOIRAI funciona sem nenhuma
# delas (só perde a sincronização com o MyAnimeList e o download automático
# via qBittorrent, que exigem credencial própria).

# Habilita a sincronização com o MyAnimeList (OAuth2 PKCE) - app "other"
# registrada em https://myanimelist.net/apiconfig, sem Client Secret.
MAL_CLIENT_ID=

# Credenciais da Web UI do qBittorrent (precisa estar habilitada nele).
QBITTORRENT_HOST=localhost
QBITTORRENT_PORT=8080
QBITTORRENT_USUARIO=
QBITTORRENT_SENHA=

# Onde avisar quando um episódio é movido pra pasta de "assistidos" sozinho -
# padrão já aponta pra ponte HTTP da GAIA, ajuste só se ela rodar noutra porta/máquina.
MOIRAI_GAIA_WEBHOOK_URL=http://127.0.0.1:8766/moirai/episodio_assistido
